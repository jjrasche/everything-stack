      "propositionCount": 10,
      "propositions": [
        {
          "content": "The Health Savings Account (HSA) is a tax-advantaged savings account.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "The HSA is designed to help individuals save for medical expenses.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "Contributions to an HSA are tax-deductible.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "Earnings on HSA investments are tax-free.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "Withdrawals for qualified medical expenses are tax-free.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "The HSA is linked to a high-deductible health plan (HDHP).",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "To be eligible for an HSA, an individual must have a HDHP.",
          "scope": "life",
          "type": "learning",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "The HSA has a maximum annual contribution limit.",
          "scope": "project",
          "type": "project",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "The HSA has a minimum deductible limit for HDHPs.",
          "scope": "project",
          "type": "project",
          "sourceIds": [
            "S1",
            "S2"
          ]
        },
        {
          "content": "The HSA is subject to certain rules and regulations.",
          "scope": "session",
